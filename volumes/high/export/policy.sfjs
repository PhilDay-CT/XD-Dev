
//
// The valid signature policy for the configuration gateway,
//
// This example uses the CA cert for "admins", so a signature from any
// user signed by that CA is valid
//
{
    certfiles: {
        Admins:  $CERT_DIR + 'users/ctxd-users-admins-ca.crt',
    },
    logic:       'Admins',
    description: "Admin policy"
}