//
// Edit this file to provide details of the
// git repository that holds the signed configuration
// data.  The account needs to have write access to
// the repository
//
// Note that the token is provided via a secret in
// the docker compose file
//
// For example:
// {
//    provider: "github",
//    origin: "github.com/MyOrg/MyConfigRepo.git",
//    user: "CT-Admin",
//    token: readstring('/run/secrets/git'),
//    branch: 'main',
// }        
//
//
{
    provider: << github | bitbucket >>,
    protocol: http,
    origin: << git repo: e.g. "bitbucket.org/my_org/config.git" >>,
    user: << git username >>,
    token: readstring('/run/secrets/git'),
    branch: 'main',
}