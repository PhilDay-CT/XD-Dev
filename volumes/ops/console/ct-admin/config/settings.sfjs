let
    GIT: require(env('SFJS_CONSOLE_ENV')+'/git.sfjs'),
    USER: require(env('SFJS_CONSOLE_ENV')+'/user.sfjs'),

in
{
    //
    // The kind of client:
    //    local:  Interacts with the system via shared directories
    //    git:    Interacts with the system via a git repository  
    //
    config_kind: 'git',
    status_kind: 'sfjsMM',


    //
    // The directory where signing and encryption keys are stored
    //
    cert_dir: env("SFJS_CONSOLE_ENV") + "/certs/signing",

    //
    // Git (config)
    //
    git: {
        provider: $GIT.provider,
        protocol: $GIT.protocol,
        user:     $GIT.user,
        config:   $GIT.origin,
        config_token: $GIT.token,
        config_branch: $GIT.branch,
        webHook: {
            enabled:  true,
            host:     "gitwh.ops.ctxd",
            port:     32004,
            protocol: https,
            hostKey:  env("SFJS_CONSOLE_ENV") + "/certs/gitWebHook/" + os_hostname() + ".pem",
            hostCert: env("SFJS_CONSOLE_ENV") + "/certs/gitWebHook/" + os_hostname() + ".crt",
            acceptCA: env("SFJS_CONSOLE_ENV") + "/certs/gitWebHook/" + @host + ".bundle.crt",
            channel:  gitWebHook,
        }
    },

    //
    // SFJS MM (status)
    //
    statusDebounce: 10,

    sfjsMM: {
        status_dir: env("SFJS_CONSOLE_ENV") + '/status', 
        host: "status.ops.ctxd",
        port: 32002,
        protocol: https,
        channel:  ctxdStatus,
        hostKey:  env("SFJS_CONSOLE_ENV") + "/certs/status/" + os_hostname() + ".pem",
        hostCert: env("SFJS_CONSOLE_ENV") + "/certs/status/" + os_hostname() + ".crt",
        acceptCA: env("SFJS_CONSOLE_ENV") + "/certs/status/" + @host + ".bundle.crt",
        //debounce: 0,
    },

    alerts: {
        enabled: true,
        host: "alerts.ops.ctxd",
        port: 32003,
        protocol: https,
        channel:  ctxdAlerts,
        hostKey:  env("SFJS_CONSOLE_ENV") + "/certs/alerts/" + os_hostname() + ".pem",
        hostCert: env("SFJS_CONSOLE_ENV") + "/certs/alerts/" + os_hostname() + ".crt",
        acceptCA: env("SFJS_CONSOLE_ENV") + "/certs/alerts/"+ @host + ".bundle.crt",
    },

    user: {
        name: $USER.name,
        password: $USER.password
    },

    contacts: {
        web:      "https://configuredthings.com",
        email:    "getconfigured@configuredthings.com",
        linkedin: "https://www.linkedin.com/company/configured-things",
        twitter:  "https://twitter.com/ConfThings"
    },

      
}
