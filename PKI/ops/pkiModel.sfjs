
let

    KEYS: {                              // for full options see node crypto module under generateKeyPair
        name: @@name,                    // Name of the key pair, will be used to generate the filename
        type: 'ec',                      // This can be 'rsa', 'dsa', 'ec', 'ed25519', 'ed448', 'x25519', 'x448', or 'dh'
        options: {
            namedCurve: "prime256v1",    // Name of the curve to use (EC).
            publicKeyEncoding:  {type: spki, format: pem},   // this is fixed... anything provided here is ignored
            privateKeyEncoding: {
                    type: sec1, 
                    format: pem, // format can be 'pkcs1' (RSA only), 'pkcs8', or 'sec1' (ec only); type can be 'pem' or 'der', if 'der' then it will also produce the 'pem', der currently supported only for pkcs8
                    passphrase: @@passphrase,
                    cipher: 'aes-256-cbc'
                },   
       },
        ECDHKeyPair: false
    },

    CERT: {
        days: 720,
        subj: {
            country:  UK,
            company:  "Configured Things Ltd.",
            organisationalUnits: @@organisationalUnits,
            commonName: @name,
            email: '',
            domain: 'ctxd',
            alternativeNames: [@name]
        }    
    },

    TYPE: {
        type: _,
        selfsign: false,
        name: _,
        keys: _,
        cert: $CERT,
        signing: [],
    },

    ROOT: $TYPE << {
        type: ROOT,
        selfsign: true,
        organisationalUnits: [],
        keys: $KEYS,
        passphrase: ""
    },

    CA: $TYPE << {
        type: CA,
        keys: $KEYS,
        passphrase: ""
    },

    SERVER: $TYPE << {
        type: SERVER,
        keys: $KEYS,
        passphrase: ""  
    },

    CLIENT: $TYPE << {
        type: CLIENT,
        keys: $KEYS,
        passphrase: ""
    },
in
    {
        signing: [
            $ROOT << {
                organisationalUnits: [],
                name: "root-ca.ops.ctxd",
                signing: [
                    $CA << {
                        name: "intermediate-ca.ops.ctxd",
                        organisationalUnits: [ctxd, Ops],
                        signing: [
 
                            //
                            // Status Server    
                            //
                            $SERVER << {
                                name: "status.ops.ctxd",
                            },
                                    
                            //
                            // Status Writers  - need to sign a cert for
                            // each high side docker that will send status
                            //
                            $CA << {
                                name: "writer-ca.status.ops.ctxd",
                                organisationalUnits: [ctxd, Ops, Status, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "import.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "export.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "mqtt.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "import.high.zone1.ctxd",
                                    },
                                    $SERVER << {
                                        name: "export.high.zone1.ctxd",
                                    },
                                    $SERVER << {
                                        name: "mqtt.high.zone1.ctxd",
                                    },
                                    $SERVER << {
                                        name: "import.high.zone2.ctxd",
                                    },
                                    $SERVER << {
                                        name: "export.high.zone2.ctxd",
                                    },
                                    $SERVER << {
                                        name: "mqtt.high.zone2.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Status Readers - need to sign a cert for each
                            // user's console
                            //
                            $CA << {
                                name: "reader-ca.status.ops.ctxd",
                                organisationalUnits: [ctxd, Ops, Status, Reader],
                                signing: [

                                    $SERVER << {
                                        name: "console.ops.ctxd",
                                    },
                                ]
                            },

                            //
                            // Alert Server    
                            //
                            $SERVER << {
                                name: "alerts.ops.ctxd",
                            },
                                    
                            //
                            // Alert Writers - need to sign a cert each high side
                            // import docker, and for each user's console 
                            //
                            $CA << {
                                name: "writer-ca.alerts.ops.ctxd",
                                organisationalUnits: [ctxd, Ops, Alerts, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "import.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "import.high.zone1.ctxd",
                                    },
                                    $SERVER << {
                                        name: "import.high.zone2.ctxd",
                                    },
                                    $SERVER << {
                                        name: "console.ops.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Git Web Hook Server    
                            //
                            $SERVER << {
                                name: "gitwh.ops.ctxd",
                            },
                                    
                            //
                            // Git WebHook Writers - need to sign a cert
                            // for each user's console 
                            //
                            $CA << {
                                name: "writer-ca.gitwh.ops.ctxd",
                                organisationalUnits: [ctxd, Ops, Gitwh, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "console.ops.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Git WebHook Readers - need sign a cert for
                            // each high side export docker
                            //
                            $CA << {
                                name: "reader-ca.gitwh.ops.ctxd",
                                organisationalUnits: [ctxd, Ops, Gitwh, Reader],
                                signing: [
                                    $SERVER << {
                                        name: "export.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "export.high.zone1.ctxd",
                                    },
                                    $SERVER << {
                                        name: "export.high.zone2.ctxd",
                                    },
                                ]
                            },
                        ],
                    },
                ]
            }
        ]
    }
    
