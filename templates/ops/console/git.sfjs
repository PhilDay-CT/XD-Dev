//
// Edit this file to provide details of the
// git repository that holds the signed configuration
// data.  The account needs to have write access to
// the repository
//
// For example:
// {
//    provider: "github",
//    user: "CT-Admin",
//    repo: "github.com/MyOrg/MyConfigRepo.git",
//    token: "ghp_NotaRealTokenN0taR3alT0kenh0nestlyxx",
//    branch: 'main',
// }        
//
//
{
    provider: << github | bitbucket >>,
    user: << git username >>,
    repo: << git repo: e.g. "bitbucket.org/my_org/config.git" >>,
    token: << git access token>>,
    branch: 'main',
}