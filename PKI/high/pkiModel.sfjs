
let

    KEYS: {                              // for full options see node crypto module under generateKeyPair
        name: @@name,                    // Name of the key pair, will be used to generate the filename
        type: 'ec',                      // This can be 'rsa', 'dsa', 'ec', 'ed25519', 'ed448', 'x25519', 'x448', or 'dh'
        options: {
            namedCurve: "prime256v1",    // Name of the curve to use (EC).
            publicKeyEncoding:  {type: spki, format: pem},   // this is fixed... anything provided here is ignored
            privateKeyEncoding: {
                    type: sec1, 
                    format: pem, // format can be 'pkcs1' (RSA only), 'pkcs8', or 'sec1' (ec only); type can be 'pem' or 'der', if 'der' then it will also produce the 'pem', der currently supported only for pkcs8
                    passphrase: @@passphrase,
                    cipher: 'aes-256-cbc'
                },   
       },
        ECDHKeyPair: false
    },

    CERT: {
        days: 720,
        subj: {
            country:  UK,
            company:  "Configured Things Ltd.",
            organisationalUnits: @@organisationalUnits,
            commonName: @name,
            email: '',
            domain: 'ctxd',
            alternativeNames: [@name]
        }    
    },

    TYPE: {
        type: _,
        selfsign: false,
        name: _,
        keys: _,
        cert: $CERT,
        signing: [],
    },

    ROOT: $TYPE << {
        type: ROOT,
        selfsign: true,
        organisationalUnits: [],
        keys: $KEYS,
        passphrase: ""
    },

    CA: $TYPE << {
        type: CA,
        keys: $KEYS,
        passphrase: ""
    },

    SERVER: $TYPE << {
        type: SERVER,
        keys: $KEYS << {ECDHKeyPair: true},
        passphrase: ""  
    },

    CLIENT: $TYPE << {
        type: CLIENT,
        keys: $KEYS << {ECDHKeyPair: true},
        passphrase: ""
    },
in
    {
        signing: [
            $ROOT << {
                organisationalUnits: [],
                name: "ctxd-high-root-ca",
                signing: [
                    $CA << {
                        name: "ctxd-high-intermediate-ca",
                        organisationalUnits: [ctxd, High],
                        signing: [
 
                            //
                            // Status Server    
                            //
                            $SERVER << {
                                name: "status.high.ctxd",
                            },
                                    
                            //
                            // Status Writers
                            //
                            $CA << {
                                name: "ctxd-high-status-writer-ca",
                                organisationalUnits: [ctxd, High, Status, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "import.high.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Status Readers
                            //
                            $CA << {
                                name: "ctxd-high-status-reader-ca",
                                organisationalUnits: [ctxd, High, Status, Reader],
                                signing: [
                                    $SERVER << {
                                        name: "console.high.ctxd",
                                    },
                                ]
                            },

                            //
                            // Alert Server    
                            //
                            $SERVER << {
                                name: "alerts.high.ctxd",
                            },
                                    
                            //
                            // Alert Writers
                            //
                            $CA << {
                                name: "ctxd-high-alerts-writer-ca",
                                organisationalUnits: [ctxd, High, Alerts, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "import.high.ctxd",
                                    },
                                    $SERVER << {
                                        name: "console.high.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Git Web Hook Server    
                            //
                            $SERVER << {
                                name: "gitwh.high.ctxd",
                            },
                                    
                            //
                            // Git WebHook  Writers
                            //
                            $CA << {
                                name: "ctxd-high-gitwh-writer-ca",
                                organisationalUnits: [ctxd, High, Gitwh, Writer],
                                signing: [
                                    $SERVER << {
                                        name: "console.high.ctxd",
                                    },
                                ]
                            },
                            
                            //
                            // Status Readers
                            //
                            $CA << {
                                name: "ctxd-high-gitwh-reader-ca",
                                organisationalUnits: [ctxd, High, Gitwh, Reader],
                                signing: [
                                    $SERVER << {
                                        name: "export.high.ctxd",
                                    },
                                ]
                            },
                        ],
                    },
                ]
            }
        ]
    }
    
